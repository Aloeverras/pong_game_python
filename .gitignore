# ==========================================
# Python (Caches, Compilations et Environnements)
# ==========================================
# Caches de bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Environnements virtuels (recommandé pour isoler tes dépendances)
.venv/
venv/
ENV/
env/
.env

# Distribution / Emballage (si tu transformes ton jeu en exécutable)
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ==========================================
# Outils de build / Gel de code (ex: PyInstaller / cx_Freeze)
# ==========================================
# Souvent utilisés pour distribuer des jeux Pygame aux joueurs
build/
*.spec

# ==========================================
# Pygame / Fichiers spécifiques au projet
# ==========================================
# Fichiers de configuration locale ou de sauvegardes de test (optionnel)
# (Si ton jeu génère des fichiers de sauvegarde localement, décommente la ligne suivante)
# sauvegarde_local.dat

# Fichiers de logs / Crash dumps
*.log
crash_report.txt

# ==========================================
# Outils de Qualité de Code et IDEs
# ==========================================
# PyCharm / WebStorm / VS Code
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Profiling et couverture de code
.toml
.cache
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ==========================================
# Systèmes d'exploitation (Fichiers poubelles)
# ==========================================
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini